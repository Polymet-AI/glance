# Required. Key from https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional. Without these the leaderboard reports itself off and the app runs
# without it. Create a database at https://console.upstash.com and copy the
# REST url and token from its details page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
