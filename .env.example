# Required. Key from https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# The browser a review runs in.
#
# Set this and pages are rendered by Firecrawl, which is what production needs:
# a real Chromium is larger than a serverless function is allowed to be. Leave
# it unset and the local Playwright browser is used instead, which reports
# richer progress and costs nothing per review, so it is the one to use in
# development. Key from https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Optional. Without these the leaderboard reports itself off and the app runs
# without it. Create a database at https://console.upstash.com and copy the
# REST url and token from its details page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
